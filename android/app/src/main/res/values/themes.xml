<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PepoMote" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/pepo_background</item>
        <item name="android:statusBarColor">@color/pepo_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/pepo_background</item>
    </style>

    <!-- Arranque: el logo sobre el fondo de la paleta (claro u oscuro) y luego el tema normal -->
    <style name="Theme.PepoMote.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pepo_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PepoMote</item>
    </style>
</resources>
